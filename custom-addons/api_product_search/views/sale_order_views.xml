<odoo>
  <record id="view_sale_order_form_custom" model="ir.ui.view">
    <field name="name">sale.order.form.custom</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">

      <xpath expr="//field[@name='order_line']/list" position="attributes">
        <attribute name="editable">bottom</attribute>
      </xpath>

      <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="before">
        <field name="sku" string="SKU" readonly="1"/>
      </xpath>

      <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
        <field name="supplier_sku" string="Supplier SKU" readonly="1"/>
      </xpath>

      <xpath expr="//field[@name='order_line']/list/field[@name='tax_id']" position="before">
        <field name="maker" string="Maker" readonly="1"/>
      </xpath>

      <xpath expr="//field[@name='order_line']/list/field[@name='tax_id']" position="after">
        <field name="volume" string="Volume/Unit" readonly="1"/>
      </xpath>

      <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
        <field name="list_price" string="List Price" readonly="1"/>
      </xpath>

      <xpath expr="//field[@name='order_line']/form//group" position="inside">
        <group string="External Product Info" colspan="2">
          <field name="sku" readonly="1"/>
          <field name="supplier_sku" readonly="1"/>
          <field name="maker" readonly="1"/>
          <field name="volume" readonly="1"/>
          <field name="list_price" readonly="1"/>
        </group>
      </xpath>

    </field>
  </record>
</odoo>
