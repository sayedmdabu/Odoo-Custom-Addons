<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Purchase Order Form View Extension -->
    <record id="view_purchase_order_form_dog_integration" model="ir.ui.view">
        <field name="name">purchase.order.form.dog.integration</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            
            <!-- Add DOG Send Button in header -->
            <xpath expr="//header" position="inside">
                <button name="action_send_to_dog_manual" 
                        string="Send to DOG API" 
                        type="object"
                        class="oe_highlight"
                        invisible="state not in ['purchase', 'done']"
                        groups="purchase.group_purchase_user"/>
            </xpath>
            
            <!-- Add Delivery Mode field after partner_id -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_delivery_mode" widget="radio"/>
                <field name="x_ship_to_partner_id" 
                       invisible="x_delivery_mode != 'customer_drop_ship'"
                       domain="[('type', 'in', ['delivery', 'other'])]"/>
            </xpath>
            
            <!-- Add line remark field in order lines list view -->
            <xpath expr="//field[@name='order_line']/list//field[@name='name']" position="after">
                <field name="x_line_remark" optional="hide" placeholder="Line remarks..."/>
            </xpath>
            
            <!-- Add DOG Export Information in a notebook page -->
            <xpath expr="//notebook" position="inside">
                <page string="DOG Integration" name="dog_integration">
                    <group>
                        <group string="Export Status">
                            <field name="export_to_dog" readonly="1"/>
                            <field name="dog_export_status" readonly="1"/>
                            <field name="dog_export_date" readonly="1"/>
                        </group>
                        <group string="API Response">
                            <field name="dog_export_message" readonly="1" colspan="2" nolabel="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
            
        </field>
    </record>
    
    <!-- Purchase Order List View Extension -->
    <record id="view_purchase_order_list_dog" model="ir.ui.view">
        <field name="name">purchase.order.list.dog</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="export_to_dog" optional="show"/>
                <field name="dog_export_status" optional="show"/>
            </xpath>
        </field>
    </record>
    
    <!-- Add filters in search view -->
    <record id="view_purchase_order_filter_dog" model="ir.ui.view">
        <field name="name">purchase.order.select.dog</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='approved']" position="after">
                <separator/>
                <filter string="Exported to DOG" name="exported_to_dog" 
                        domain="[('export_to_dog', '=', True)]"/>
                <filter string="Not Exported to DOG" name="not_exported_to_dog" 
                        domain="[('export_to_dog', '=', False)]"/>
                <filter string="Export Failed" name="export_failed" 
                        domain="[('dog_export_status', '=', 'failed')]"/>
            </xpath>
        </field>
    </record>
    
</odoo>
