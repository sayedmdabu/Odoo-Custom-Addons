<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view for search results (Odoo 18) -->
    <record id="view_ec250_api_search_result_list" model="ir.ui.view">
        <field name="name">ec250.api.search.result.list</field>
        <field name="model">ec250.api.search.result</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Products" create="false" edit="false" delete="false">
                <field name="sku"/>
                <field name="name"/>
                <field name="supplier_sku"/>
                <field name="maker_name"/>
                <field name="volume_unit_label"/>
                <field name="list_price"/>
                <button name="action_select_single"
                        type="object"
                        string="Select"
                        class="btn-primary btn-sm"/>
            </list>
        </field>
    </record>

    <!-- EC250 Search Wizard Form View -->
    <record id="view_ec250_api_search_wizard_form" model="ir.ui.view">
        <field name="name">ec250.api.search.wizard.form</field>
        <field name="model">ec250.api.search.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="EC250 Product Search">
                <sheet>
                    <!-- Search Criteria -->
                    <group string="Search Criteria">
                        <group>
                            <field name="keywords" placeholder="Enter keywords..."/>
                            <field name="supplier_sku" placeholder="Supplier SKU"/>
                            <field name="name" placeholder="Product name"/>
                        </group>
                        <group>
                            <field name="maker_name" placeholder="Maker name"/>
                            <field name="sales_origin_maker_name" placeholder="Sales origin maker"/>
                            <field name="cas_code" placeholder="CAS code"/>
                        </group>
                    </group>
                    
                    <!-- Pagination Settings -->
                    <group string="Settings">
                        <group>
                            <field name="page"/>
                            <field name="limit"/>
                        </group>
                        <group>
                            <field name="total" readonly="1"/>
                        </group>
                    </group>
                    
                    <!-- Search Results -->
                    <separator string="Search Results"/>
                    <field name="result_ids" nolabel="1"
                           context="{'list_view_ref': 'ec250_product_api.view_ec250_api_search_result_list'}"/>
                </sheet>
                
                <footer>
                    <button name="action_search"
                            type="object"
                            string="Search"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
