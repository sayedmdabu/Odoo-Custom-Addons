<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Default PDF Configuration -->
        <record id="default_pdf_config" model="monthly.billing.pdf.config">
            <field name="name">Default Configuration</field>
            <field name="is_default" eval="True"/>
            <field name="active" eval="True"/>
            
            <!-- Colors -->
            <field name="primary_color">#2c5aa0</field>
            <field name="secondary_color">#5a8fd8</field>
            <field name="header_border_color">#2c5aa0</field>
            <field name="table_header_bg_color">#2c5aa0</field>
            <field name="table_header_text_color">#ffffff</field>
            <field name="amount_box_border_color">#2c5aa0</field>
            <field name="total_amount_bg_color">#2c5aa0</field>
            <field name="info_box_bg_color">#f8f9fa</field>
            <field name="table_border_color">#dee2e6</field>
            <field name="table_stripe_color">#f8f9fa</field>
            
            <!-- Logo -->
            <field name="show_logo" eval="True"/>
            <field name="logo_position">left</field>
            <field name="logo_max_width">200</field>
            <field name="logo_max_height">80</field>
            
            <!-- Header -->
            <field name="header_title_en">Monthly Billing Statement</field>
            <field name="header_title_ja">月次請求書</field>
            <field name="header_title_size">28</field>
            <field name="header_subtitle_size">20</field>
            <field name="show_status_badge" eval="True"/>
            
            <!-- Sections -->
            <field name="show_customer_section" eval="True"/>
            <field name="show_period_section" eval="True"/>
            <field name="show_amount_summary" eval="True"/>
            <field name="show_invoice_details" eval="True"/>
            <field name="show_notes_section" eval="True"/>
            <field name="show_payment_info" eval="True"/>
            <field name="show_contact_info" eval="True"/>
            <field name="show_footer" eval="True"/>
            
            <!-- Text Labels -->
            <field name="customer_section_title_en">Bill To</field>
            <field name="customer_section_title_ja">請求先</field>
            <field name="period_section_title_en">Billing Period</field>
            <field name="period_section_title_ja">請求期間</field>
            <field name="invoice_details_title_en">Invoice Details</field>
            <field name="invoice_details_title_ja">請求明細</field>
            <field name="payment_info_title_en">Payment Information</field>
            <field name="payment_info_title_ja">お支払い先</field>
            <field name="contact_info_title_en">Contact Information</field>
            <field name="contact_info_title_ja">お問い合わせ先</field>
            
            <!-- Amount Labels -->
            <field name="subtotal_label_en">Subtotal</field>
            <field name="subtotal_label_ja">税抜合計</field>
            <field name="tax_label_en">Tax Amount</field>
            <field name="tax_label_ja">消費税</field>
            <field name="total_label_en">Total Amount</field>
            <field name="total_label_ja">税込合計</field>
            
            <!-- Table -->
            <field name="table_show_row_numbers" eval="True"/>
            <field name="table_stripe_rows" eval="True"/>
            
            <!-- Layout -->
            <field name="page_margin_top">15</field>
            <field name="page_margin_bottom">15</field>
            <field name="section_spacing">25</field>
            <field name="base_font_size">12</field>
            <field name="font_family">default</field>
            
            <!-- Footer -->
            <field name="footer_text_en">This document was automatically generated by the Monthly Billing System.</field>
            <field name="footer_text_ja">本書類は月次請求システムにより自動生成されました。</field>
            
            <!-- Watermark -->
            <field name="show_watermark" eval="False"/>
            <field name="watermark_text">DRAFT</field>
            <field name="watermark_opacity">0.1</field>
        </record>

    </data>
</odoo>
