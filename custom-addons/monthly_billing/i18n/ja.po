#. module: monthly_billing
#: code:addons/monthly_billing/wizards/monthly_billing_generate_wizard.py
msgid "Invalid closing year/month format. Use YYYY-MM (e.g., 2025-10)"
msgstr "締年月の形式が不正です。YYYY-MM形式で入力してください（例：2025-10）"

#. module: monthly_billing
#: code:addons/monthly_billing/wizards/monthly_billing_generate_wizard.py
msgid "Closing day must be between 1 and 31."
msgstr "締日は1から31の間で指定してください。"

#. module: monthly_billing
#: code:addons/monthly_billing/wizards/monthly_billing_generate_wizard.py
msgid "Please specify valid closing year/month and closing day."
msgstr "有効な締年月と締日を指定してください。"

#. module: monthly_billing
#: code:addons/monthly_billing/wizards/monthly_billing_generate_wizard.py
msgid "No invoices found for the specified period and criteria."
msgstr "指定された期間と条件で請求書が見つかりませんでした。"

#. module: monthly_billing
#: code:addons/monthly_billing/wizards/monthly_billing_generate_wizard.py
msgid "Generated Monthly Billings"
msgstr "生成された月次請求"

#. module: monthly_billing
#: code:addons/monthly_billing/models/monthly_billing_header.py
msgid "Only draft billings can be confirmed."
msgstr "下書き状態の請求のみ確認できます。"

#. module: monthly_billing
#: code:addons/monthly_billing/models/monthly_billing_header.py
msgid "Cannot confirm billing without invoice lines."
msgstr "請求明細なしでは確認できません。"

#. module: monthly_billing
#: code:addons/monthly_billing/models/monthly_billing_header.py
msgid "Only confirmed billings can be marked as done."
msgstr "確認済の請求のみ完了にできます。"

#. module: monthly_billing
#: code:addons/monthly_billing/models/monthly_billing_header.py
msgid "Cannot cancel a done billing."
msgstr "完了した請求はキャンセルできません。"

#. module: monthly_billing
#: code:addons/monthly_billing/models/monthly_billing_header.py
msgid "Only cancelled billings can be reset to draft."
msgstr "キャンセルされた請求のみ下書きに戻せます。"

#. module: monthly_billing
#: code:addons/monthly_billing/models/monthly_billing_header.py
msgid "Closing Year/Month must be in format YYYY-MM (e.g., 2025-10)"
msgstr "締年月はYYYY-MM形式で入力してください（例：2025-10）"

#. module: monthly_billing
#: code:addons/monthly_billing/models/monthly_billing_header.py
msgid "Period start date must be before or equal to period end date."
msgstr "対象開始日は対象終了日以前である必要があります。"

