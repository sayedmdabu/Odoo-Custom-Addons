<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Monthly Billing Module Category -->
        <record id="module_category_monthly_billing" model="ir.module.category">
            <field name="name">Monthly Billing</field>
            <field name="description">Manage monthly billing and consolidated invoicing</field>
            <field name="sequence">10</field>
        </record>

        <!-- Monthly Billing User Group -->
        <record id="group_monthly_billing_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_monthly_billing"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Monthly Billing User: Can view and use monthly billing features</field>
        </record>

        <!-- Monthly Billing Manager Group -->
        <record id="group_monthly_billing_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_monthly_billing"/>
            <field name="implied_ids" eval="[(4, ref('group_monthly_billing_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Monthly Billing Manager: Full access to monthly billing features</field>
        </record>

        <!-- Record Rules -->
        
        <!-- Multi-company rule for monthly billing header -->
        <record id="monthly_billing_header_comp_rule" model="ir.rule">
            <field name="name">Monthly Billing Header: multi-company</field>
            <field name="model_id" ref="model_monthly_billing_header"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Multi-company rule for monthly billing line -->
        <record id="monthly_billing_line_comp_rule" model="ir.rule">
            <field name="name">Monthly Billing Line: multi-company</field>
            <field name="model_id" ref="model_monthly_billing_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
