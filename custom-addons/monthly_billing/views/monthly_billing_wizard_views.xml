<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Monthly Billing Generation Wizard Form View -->
        <record id="view_monthly_billing_generate_wizard_form" model="ir.ui.view">
            <field name="name">monthly.billing.generate.wizard.form</field>
            <field name="model">monthly.billing.generate.wizard</field>
            <field name="arch" type="xml">
                <form string="Generate Monthly Billing">
                    <sheet>
                        <div class="alert alert-info" role="alert">
                            <p><strong>Monthly Billing Generation Wizard</strong></p>
                            <p>This wizard will generate monthly billing statements by aggregating invoices for the specified closing period.</p>
                        </div>
                        
                        <group>
                            <group string="Closing Period" name="closing_period">
                                <field name="closing_year_month" placeholder="YYYY-MM (e.g., 2025-10)"/>
                                <field name="closing_day"/>
                            </group>
                            <group string="Calculated Period" name="calculated_period">
                                <label for="period_start_date" string="Period"/>
                                <div class="o_row">
                                    <field name="period_start_date" readonly="1" class="oe_inline"/>
                                    <span class="mx-2"> to </span>
                                    <field name="period_end_date" readonly="1" class="oe_inline"/>
                                </div>
                            </group>
                        </group>
                        
                        <group>
                            <group string="Target Selection" name="target_selection">
                                <field name="partner_ids" widget="many2many_tags" 
                                       placeholder="Leave empty for all customers..."
                                       options="{'no_create': True}"/>
                                <field name="invoice_state_filter"/>
                                <field name="company_id" groups="base.group_multi_company" 
                                       options="{'no_create': True}"/>
                            </group>
                            <group string="Options" name="options">
                                <field name="dry_run"/>
                                <field name="show_preview" invisible="1"/>
                            </group>
                        </group>
                        
                        <group string="Estimated Results" name="estimates" 
                               invisible="not period_start_date or not period_end_date">
                            <group>
                                <field name="estimated_customer_count" readonly="1"/>
                                <field name="estimated_invoice_count" readonly="1"/>
                            </group>
                        </group>
                        
                        <notebook invisible="not show_preview">
                            <page string="Preview" name="preview">
                                <field name="preview_html" widget="html" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button name="action_preview_target" string="Preview" type="object" 
                                class="btn-secondary"/>
                        <button name="action_generate_monthly_billing" string="Generate Monthly Billing" 
                                type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Monthly Billing Generation Wizard Action -->
        <record id="action_monthly_billing_generate_wizard" model="ir.actions.act_window">
            <field name="name">Generate Monthly Billing</field>
            <field name="res_model">monthly.billing.generate.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_monthly_billing_header"/>
        </record>

    </data>
</odoo>
