<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Login Form View -->
    <record id="view_ordia_login_form" model="ir.ui.view">
        <field name="name">ordia.login.form</field>
        <field name="model">ordia.login</field>
        <field name="arch" type="xml">
            <form string="ORDIA Login">
                <sheet>
                    <div class="oe_title">
                        <h1>ORDIA Login</h1>
                    </div>
                    <group>
                        <group>
                            <field name="username" placeholder="Enter username"/>
                            <field name="password" password="True" placeholder="Enter password"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Login" name="action_login" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Login Action -->
    <record id="action_ordia_login" model="ir.actions.act_window">
        <field name="name">ORDIA Login</field>
        <field name="res_model">ordia.login</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Main ORDIA Action - Checks token and redirects accordingly -->
    <record id="action_ordia_main" model="ir.actions.server">
        <field name="name">Open ORDIA</field>
        <field name="model_id" ref="model_ordia_login"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_ordia()</field>
    </record>

    <!-- Clear Token Action -->
    <record id="action_ordia_clear_token" model="ir.actions.server">
        <field name="name">Clear Token (Logout)</field>
        <field name="model_id" ref="model_ordia_login"/>
        <field name="state">code</field>
        <field name="code">action = model.action_clear_token()</field>
    </record>
</odoo>