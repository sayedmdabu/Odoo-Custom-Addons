<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Company Form View -->
        <record id="view_company_form_inherit_ordia" model="ir.ui.view">
            <field name="name">res.company.form.inherit.ordia</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <!-- Add field after Currency field -->
                <xpath expr="//field[@name='currency_id']" position="after">
                    <field name="x_external_company_cod" placeholder="Enter ORDIA Corporate Code"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>