<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Inherit Product Template Form View -->
    <record id="view_product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            
            <!-- Add buttons to manually process -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_extract_supplier_code" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-code"
                        string="Extract Supplier Code"
                        invisible="api_supplier_comp_code"
                        help="Auto-extract supplier code from SKU"
                        groups="purchase.group_purchase_user"/>
                
                <button name="action_reprocess_product" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-refresh"
                        string="Reprocess"
                        groups="purchase.group_purchase_manager"/>
            </xpath>
            
            <!-- Add notebook page for external data -->
            <xpath expr="//notebook" position="inside">
                <page string="External API Data" name="external_api_data">
                    <group>
                        <group name="api_identification" string="Product Identification">
                            <field name="api_sku"/>
                            <field name="api_supplier_sku"/>
                            <field name="api_supplier_comp_code" 
                                   decoration-danger="not api_supplier_comp_code"
                                   decoration-success="api_supplier_comp_code"/>
                            <field name="api_supplier_comp_name"/>
                        </group>
                        <group name="api_pricing" string="Pricing Configuration">
                            <field name="api_price_group" 
                                   help="Price group for automatic discount calculation"/>
                            <field name="api_maker" 
                                   help="Manufacturer for automatic discount calculation"/>
                            <field name="api_sales_origin_maker_name"/>
                            <field name="api_list_price"/>
                            <field name="purchase_price_fixed" 
                                   string="Fixed Purchase Price (Highest Priority)"/>
                        </group>
                    </group>
                    <group name="api_other">
                        <field name="api_volume"/>
                    </group>
                    
                    <separator string="Auto-Processing Status"/>
                    <group>
                        <group>
                            <field name="auto_process_status" 
                                   widget="badge"
                                   decoration-success="auto_process_status == 'success'"
                                   decoration-warning="auto_process_status == 'processing'"
                                   decoration-danger="auto_process_status == 'error'"
                                   decoration-info="auto_process_status == 'pending'"/>
                        </group>
                        <group>
                            <field name="auto_process_message" 
                                   invisible="not auto_process_message"
                                   nolabel="1"
                                   colspan="2"/>
                        </group>
                    </group>
                    
                    <separator string="Configuration Help"/>
                    <div class="alert alert-info" role="alert">
                        <p><strong>For Automatic Discounts in Sales:</strong></p>
                        <ol>
                            <li><strong>Supplier Company Code</strong> - Must match your Price Group Rate or Maker Rate configuration (e.g., "20000109")</li>
                            <li><strong>Price Group</strong> - Used for Priority 1 discount calculation</li>
                            <li><strong>Manufacturer (Maker)</strong> - Used for Priority 2 discount calculation if Price Group not found</li>
                        </ol>
                        <p class="mb-0"><strong>Quick Setup:</strong> If SKU starts with supplier code, click "Extract Supplier Code" button above.</p>
                    </div>
                    
                    <separator string="Auto-Processing"/>
                    <div class="alert alert-warning" role="alert">
                        <p><strong>Auto-Processing:</strong> When this product is created or updated, 
                        the system will automatically:</p>
                        <ul>
                            <li>Assign Buy and MTO routes</li>
                            <li>Map external supplier code to Odoo vendor</li>
                            <li>Calculate purchase price using rate masters</li>
                            <li>Create/update supplier info</li>
                        </ul>
                        <p class="mb-0">Use the <strong>Reprocess</strong> button to manually trigger this process.</p>
                    </div>
                </page>
            </xpath>
            
        </field>
    </record>

    <!-- Inherit Product Template Tree View -->
    <record id="view_product_template_tree_inherit" model="ir.ui.view">
        <field name="name">product.template.tree.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="api_sku" optional="hide"/>
                <field name="api_supplier_comp_code" optional="show"
                       decoration-danger="not api_supplier_comp_code"
                       decoration-success="api_supplier_comp_code"/>
                <field name="api_price_group" optional="hide"/>
                <field name="auto_process_status" optional="show"
                       widget="badge"
                       decoration-success="auto_process_status == 'success'"
                       decoration-warning="auto_process_status == 'processing'"
                       decoration-danger="auto_process_status == 'error'"
                       decoration-info="auto_process_status == 'pending'"/>
            </xpath>
        </field>
    </record>

    <!-- Add search filters -->
    <record id="view_product_template_search_inherit" model="ir.ui.view">
        <field name="name">product.template.search.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="api_sku"/>
                <field name="api_supplier_comp_code"/>
                <field name="api_price_group"/>
            </xpath>
            
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator/>
                <filter string="Has API SKU" name="filter_has_api_sku" 
                        domain="[('api_sku', '!=', False)]"/>
                <filter string="Has Supplier Code" name="filter_has_supplier_code" 
                        domain="[('api_supplier_comp_code', '!=', False)]"/>
                <filter string="Missing Supplier Code" name="filter_missing_supplier_code" 
                        domain="[('api_supplier_comp_code', '=', False), ('api_sku', '!=', False)]"/>
                <filter string="Has Fixed Price" name="filter_has_fixed_price" 
                        domain="[('purchase_price_fixed', '>', 0)]"/>
            </xpath>
        </field>
    </record>

    <!-- Add action to extract supplier codes in bulk -->
    <record id="action_extract_supplier_codes_bulk" model="ir.actions.server">
        <field name="name">Extract Supplier Codes</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_extract_supplier_code()
        </field>
    </record>

</odoo>