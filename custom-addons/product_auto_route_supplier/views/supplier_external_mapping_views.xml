<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Form View -->
    <record id="view_supplier_external_mapping_form" model="ir.ui.view">
        <field name="name">supplier.external.mapping.form</field>
        <field name="model">supplier.external.mapping</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="external_supplier_comp_code"/>
                            <field name="external_supplier_name"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_supplier_external_mapping_list" model="ir.ui.view">
        <field name="name">supplier.external.mapping.list</field>
        <field name="model">supplier.external.mapping</field>
        <field name="arch" type="xml">
            <list>
                <field name="external_supplier_comp_code"/>
                <field name="external_supplier_name"/>
                <field name="partner_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_supplier_external_mapping_search" model="ir.ui.view">
        <field name="name">supplier.external.mapping.search</field>
        <field name="model">supplier.external.mapping</field>
        <field name="arch" type="xml">
            <search>
                <field name="external_supplier_comp_code"/>
                <field name="partner_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_supplier_external_mapping" model="ir.actions.act_window">
        <field name="name">External Code → Vendor Conversion</field>
        <field name="res_model">supplier.external.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>