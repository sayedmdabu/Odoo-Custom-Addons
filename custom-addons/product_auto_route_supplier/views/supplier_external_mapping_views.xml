<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- List View (Changed from Tree in Odoo 18) -->
    <record id="view_supplier_external_mapping_tree" model="ir.ui.view">
        <field name="name">supplier.external.mapping.tree</field>
        <field name="model">supplier.external.mapping</field>
        <field name="arch" type="xml">
            <list string="External Code → Vendor Conversion">
                <field name="external_supplier_comp_code"/>
                <field name="external_supplier_name"/>
                <field name="partner_id"/>
                <field name="priority"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_supplier_external_mapping_form" model="ir.ui.view">
        <field name="name">supplier.external.mapping.form</field>
        <field name="model">supplier.external.mapping</field>
        <field name="arch" type="xml">
            <form string="External Code → Vendor Conversion">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" 
                                invisible="active"/>
                    </div>
                    
                    <group>
                        <group name="external_info">
                            <field name="external_supplier_comp_code" 
                                   placeholder="e.g., COSMO001"/>
                            <field name="external_supplier_name" 
                                   placeholder="External supplier name (optional)"/>
                        </group>
                        <group name="odoo_info">
                            <field name="partner_id" 
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="priority"/>
                            <field name="active"/>
                        </group>
                    </group>
                    
                    <group name="notes">
                        <field name="note" placeholder="Optional notes..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_supplier_external_mapping_search" model="ir.ui.view">
        <field name="name">supplier.external.mapping.search</field>
        <field name="model">supplier.external.mapping</field>
        <field name="arch" type="xml">
            <search string="Search External Code Mapping">
                <field name="external_supplier_comp_code"/>
                <field name="external_supplier_name"/>
                <field name="partner_id"/>
                
                <filter string="Active" name="filter_active" 
                        domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="filter_inactive" 
                        domain="[('active', '=', False)]"/>
                <filter string="Vendor Not Set" name="filter_no_vendor" 
                        domain="[('partner_id', '=', False)]"/>
                
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Vendor" name="group_vendor" 
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Active Status" name="group_active" 
                            context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_supplier_external_mapping" model="ir.actions.act_window">
        <field name="name">External Code → Vendor Conversion</field>
        <field name="res_model">supplier.external.mapping</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new external code mapping
            </p>
            <p>
                Map external supplier codes from your API/data feed to Odoo vendors.
                This enables automatic vendor identification during product synchronization.
            </p>
        </field>
    </record>

</odoo>