<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cart Search Form View -->
    <record id="view_ordia_cart_search_form" model="ir.ui.view">
        <field name="name">ordia.cart.search.form</field>
        <field name="model">ordia.cart.search</field>
        <field name="arch" type="xml">
            <form string="Search Carts">
                <sheet>
                    <div class="oe_title">
                        <h1>Search ORDIA Carts</h1>
                    </div>
                    <group>
                        <group>
                            <field name="token" readonly="1"/>
                            <field name="dealer_co_cd" readonly="1"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="cart_seq"/>
                            <field name="item_sku"/>
                            <field name="customer_email"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Search" name="action_search_carts" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Permanent Cart List View - Workflow Buttons (NO Save to Database) -->
    <record id="view_ordia_cart_list" model="ir.ui.view">
        <field name="name">ordia.cart.list</field>
        <field name="model">ordia.cart</field>
        <field name="arch" type="xml">
            <list string="ORDIA Carts - Saved in Database" create="false" multi_edit="1" delete="true">
                <!-- Workflow Buttons (NO Save to Database) -->
                <header>
                    <button name="action_confirm_carts" 
                            string="✓ Confirm Selected" 
                            type="object" 
                            class="btn-success"/>
                    <button name="action_process_carts" 
                            string="⚙ Process Selected" 
                            type="object" 
                            class="btn-info"/>
                    <button name="action_mark_done" 
                            string="✓ Mark Done" 
                            type="object" 
                            class="btn-primary"/>
                    <button name="action_cancel_carts" 
                            string="✗ Cancel Selected" 
                            type="object" 
                            class="btn-warning"/>
                </header>
                
                <!-- Status Badge -->
                <field name="state" widget="badge" 
                       decoration-success="state == 'done'"
                       decoration-info="state == 'confirmed'"
                       decoration-warning="state == 'processing'"
                       decoration-danger="state == 'cancelled'"
                       decoration-muted="state == 'draft'"/>
                
                <!-- Cart Fields -->
                <field name="cart_seq"/>
                <field name="order_date"/>
                <field name="maker_name"/>
                <field name="item_sku"/>
                <field name="item_name"/>
                <field name="capacity"/>
                <field name="suryo"/>
                <field name="tanka" widget="monetary" options="{'currency_field': 'False'}"/>
                <field name="total_amount" sum="Total" widget="monetary" options="{'currency_field': 'False'}"/>
                <field name="customer_kikanname"/>
                <field name="customer_tanto"/>
                <field name="customer_email"/>
                <field name="api_status"/>
            </list>
        </field>
    </record>

    <!-- Permanent Cart Form View -->
    <record id="view_ordia_cart_form" model="ir.ui.view">
        <field name="name">ordia.cart.form</field>
        <field name="model">ordia.cart</field>
        <field name="arch" type="xml">
            <form string="Cart Details">
                <header>
                    <!-- Status Bar -->
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,confirmed,processing,done"/>
                    
                    <!-- Action Buttons -->
                    <button name="action_confirm_carts" 
                            string="Confirm" 
                            type="object" 
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_process_carts" 
                            string="Process" 
                            type="object" 
                            class="btn-primary"
                            invisible="state not in ['draft', 'confirmed']"/>
                    <button name="action_mark_done" 
                            string="Mark Done" 
                            type="object" 
                            class="btn-success"
                            invisible="state != 'processing'"/>
                    <button name="action_cancel_carts" 
                            string="Cancel" 
                            type="object" 
                            class="btn-warning"
                            invisible="state == 'done'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="cart_seq" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Order Information">
                            <field name="order_date"/>
                            <field name="api_status"/>
                            <field name="dealer_co_cd"/>
                            <field name="customer_kikanname"/>
                            <field name="customer_sosikiname"/>
                            <field name="customer_tanto"/>
                            <field name="customer_email"/>
                        </group>
                        <group string="Product Information">
                            <field name="maker_name"/>
                            <field name="item_sku"/>
                            <field name="supp_sku"/>
                            <field name="manufacturer_sku"/>
                            <field name="supplier_system_sku"/>
                        </group>
                    </group>
                    <group>
                        <group string="Product Details">
                            <field name="item_name"/>
                            <field name="capacity"/>
                            <field name="volume_unit_label"/>
                            <field name="kikaku"/>
                        </group>
                        <group string="Pricing">
                            <field name="suryo"/>
                            <field name="teika_tanka" widget="monetary" options="{'currency_field': 'False'}"/>
                            <field name="tanka" widget="monetary" options="{'currency_field': 'False'}"/>
                            <field name="total_amount" widget="monetary" options="{'currency_field': 'False'}"/>
                        </group>
                    </group>
                    <group string="Delivery Address">
                        <field name="nonyu_address1"/>
                        <field name="nonyu_address2"/>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Add notes here..."/>
                        </page>
                        <page string="Audit Information">
                            <group>
                                <group>
                                    <field name="create_date" readonly="1"/>
                                    <field name="create_uid" readonly="1"/>
                                </group>
                                <group>
                                    <field name="write_date" readonly="1"/>
                                    <field name="write_uid" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Permanent Cart Search View -->
    <record id="view_ordia_cart_search" model="ir.ui.view">
        <field name="name">ordia.cart.search</field>
        <field name="model">ordia.cart</field>
        <field name="arch" type="xml">
            <search string="Search Carts">
                <field name="cart_seq"/>
                <field name="item_sku"/>
                <field name="item_name"/>
                <field name="maker_name"/>
                <field name="customer_email"/>
                <field name="customer_kikanname"/>
                <field name="dealer_co_cd"/>
                <field name="api_status"/>
                <field name="state"/>
                
                <!-- Filters by Status -->
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Processing" name="filter_processing" domain="[('state', '=', 'processing')]"/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                
                <!-- Filters by Date -->
                <separator/>
                <filter string="Today" name="filter_today" 
                        domain="[('order_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                ('order_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="This Week" name="filter_week" 
                        domain="[('order_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="This Month" name="filter_month" 
                        domain="[('order_date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d 00:00:00'))]"/>
                
                <!-- Group By -->
                <separator/>
                <filter string="Group by Status" name="group_by_status" context="{'group_by': 'state'}"/>
                <filter string="Group by Maker" name="group_by_maker" context="{'group_by': 'maker_name'}"/>
                <filter string="Group by Customer" name="group_by_customer" context="{'group_by': 'customer_kikanname'}"/>
                <filter string="Group by API Status" name="group_by_api_status" context="{'group_by': 'api_status'}"/>
                <filter string="Group by Order Date" name="group_by_order_date" context="{'group_by': 'order_date:month'}"/>
            </search>
        </field>
    </record>

    <!-- Permanent Cart Action -->
    <record id="action_ordia_cart" model="ir.actions.act_window">
        <field name="name">ORDIA Carts (Saved)</field>
        <field name="res_model">ordia.cart</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_maker': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No saved carts found!
            </p>
            <p>
                Click on "Login" menu to authenticate and search for carts from ORDIA API.
                Then select carts and click "Save to Database" button.
            </p>
        </field>
    </record>
</odoo>